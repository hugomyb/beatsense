{
  "manifest_version": 3,
  "name": "BeatSense",
  "version": "1.0.0",
  "description": "BPM, tonalité et téléchargement des prods directement sur YouTube.",
  "browser_specific_settings": {
    "gecko": {
      "id": "beatsense@hugo.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": [],
  "host_permissions": ["http://127.0.0.1:7843/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
