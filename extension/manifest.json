{
  "manifest_version": 2,
  "name": "BeatSense",
  "version": "1.1.0",
  "description": "BPM, tonalité et téléchargement des prods directement sur YouTube.",
  "browser_specific_settings": {
    "gecko": {
      "id": "beatsense@hugo.local",
      "strict_min_version": "115.0",
      "update_url": "https://raw.githubusercontent.com/hugomyb/beatsense/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "http://127.0.0.1:7843/*"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "background": {
    "scripts": [
      "lib/exports-shim.js",
      "lib/essentia-wasm.umd.js",
      "lib/essentia.js-core.umd.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "BeatSense",
    "default_popup": "popup/popup.html"
  }
}
